# Copie este ficheiro para .env e preencha. O .env está no .gitignore: nunca o adicione ao git.

# Fase 3 – análise qualitativa com Gemini (SDK google-genai). Sem chave, o pipeline corre sem IA.
GEMINI_API_KEY=
# Opcional: modelo a usar (tem prioridade sobre ai.model no config.yaml)
GEMINI_MODEL=gemini-3.8-flash

# Opcional: notícias via Finnhub (endpoint company-news, últimos 30 dias). Sem chave usa-se o yfinance.
FINNHUB_API_KEY=
